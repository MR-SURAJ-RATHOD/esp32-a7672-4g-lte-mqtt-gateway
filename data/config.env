# =============================================================================
# Device configuration template (upload to ESP32 SPIFFS)
#
# HOW TO USE:
#   1. Copy this file to data/config.local.env and fill YOUR real values.
#   2. Keep config.env as reference OR edit both before upload.
#   3. Upload filesystem:  pio run -t uploadfs
#   4. Upload firmware:    pio run -t upload
#
# config.local.env overrides the same keys in config.env (recommended for secrets).
# config.local.env is gitignored — do not commit passwords.
# =============================================================================

# --- Device identity (CUSTOMIZE for your deployment) ---
DEVICE_ID=YOUR_DEVICE_ID
ASSET_ID=YOUR_ASSET_ID
TENANT_ID=YOUR_TENANT_ID

# --- MQTT broker (CUSTOMIZE) ---
MQTT_BROKER=YOUR_MQTT_BROKER_HOST
MQTT_PORT=1883
MQTT_CLIENT_USER=YOUR_MQTT_USERNAME
MQTT_CLIENT_PASS=YOUR_MQTT_PASSWORD
MQTT_METRICS_TOPIC=YOUR_MQTT_PUBLISH_TOPIC

# --- Cellular APN (CUSTOMIZE for your SIM operator; leave blank to use auto-detect) ---
APN=YOUR_APN
APN_USER=
APN_PASS=

# --- Timing (milliseconds) ---
PUBLISH_INTERVAL_MS=60000
NETWORK_REGISTER_TIMEOUT_MS=60000
GPRS_ATTACH_TIMEOUT_MS=30000
MQTT_RECONNECT_DELAY_MS=5000
