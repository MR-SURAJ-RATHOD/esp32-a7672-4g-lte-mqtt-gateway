# Copy to config.local.env and fill YOUR values (this file is safe to commit).
# PlatformIO uploads everything under data/ to SPIFFS.
#
#   copy config.local.env.example config.local.env
#
# Keys here override the same keys in config.env.

DEVICE_ID=GW-EXAMPLE-001
ASSET_ID=ASSET-EXAMPLE-001
TENANT_ID=tenant-example

MQTT_BROKER=192.168.1.100
MQTT_PORT=1883
MQTT_CLIENT_USER=mqtt_user
MQTT_CLIENT_PASS=mqtt_password
MQTT_METRICS_TOPIC=devices/telemetry

APN=internet
APN_USER=
APN_PASS=

PUBLISH_INTERVAL_MS=60000
